# ==========================================
# RIMBA GEAR - KONFIGURASI DATABASE & APLIKASI
# ==========================================

# 1. Konfigurasi Supabase (Berbagi 1 project dengan website lain)
# Prefix tabel yang digunakan: outdoor_ (contoh: outdoor_products, outdoor_categories)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key (secret, untuk server-side):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Supabase Storage Bucket
# Nama bucket khusus untuk website ini (buat di Supabase -> Storage -> New Bucket -> 'outdoor' dan set Public)
NEXT_PUBLIC_SUPABASE_BUCKET=outdoor

# 3. Nomor WhatsApp Admin untuk menerima konfirmasi sewa
# Gunakan format kode negara tanpa tanda + (contoh: 6281234567890)
NEXT_PUBLIC_ADMIN_WHATSAPP=6281234567890

# 4. Kredensial Admin Default (juga tersimpan di tabel outdoor_admins database)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 5. Fallback Legacy Database (Opsional: jika Supabase URL tidak diisi, otomatis pakai file:rimbagear.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
