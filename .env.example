# ==========================================
# RIMBA GEAR - KONFIGURASI DATABASE & APLIKASI
# ==========================================

# 1. Konfigurasi Database Turso (Edge SQLite)
# Dapatkan URL dan Token dari CLI Turso:
#   turso db create rimbagear-db
#   turso db show rimbagear-db --url
#   turso db tokens create rimbagear-db
#
# Jika dikosongkan, aplikasi otomatis menggunakan local SQLite database (file:rimbagear.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Nomor WhatsApp Admin untuk menerima konfirmasi sewa
# Gunakan format kode negara tanpa tanda + (contoh: 6281234567890)
NEXT_PUBLIC_ADMIN_WHATSAPP=6281234567890

# 3. Kredensial Admin Default (juga tersimpan di tabel admins database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rimbagear2026

# 4. Konfigurasi Cloudinary (Upload Gambar Cloud Gratis Tanpa Kartu Kredit)
# Dapatkan dari Dashboard cloudinary.com:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

